{
  "id": "camp_pecheurs",
  "name": "Camp des Pêcheurs du Soir",
  "type": "camp",
  "position": {
    "x": 45,
    "y": 78
  },
  "visibility": "visible",
  "description": "Quelques cabanes de bois flotté s'alignent près de l'eau, filets séchant au vent inexistant. Les pêcheurs parlent à voix basse de choses qu'ils préfèrent ne pas nommer.",
  "unlock_condition": {
    "type": "level",
    "min": 3
  },
  "hint": "Les pêcheurs n'accueillent que ceux qui ont déjà fait leurs preuves.",
  "generation_brief": {
    "level_range": [
      4,
      6
    ],
    "difficulty_tier": "coeur",
    "tags": [
      "camp",
      "peche",
      "social",
      "artisanat"
    ],
    "content_intent": "Petit camp de pêcheurs superstitieux, PNJ donnant objets et rumeurs, artisanat léger lié à la pêche, pas de combat significatif.",
    "provides": [
      {
        "type": "item",
        "id_suggere": "amulette_pecheur",
        "via": "Un vieux pêcheur superstitieux offre une amulette tressée d'algues séchées à quiconque l'aide à réparer ses filets."
      }
    ]
  },
