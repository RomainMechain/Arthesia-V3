{
  "id": "ruines_architectes",
  "name": "Ruines d'Orvalt",
  "type": "ruins",
  "position": {
    "x": 65,
    "y": 48
  },
  "visibility": "visible",
  "description": "Des blocs de pierre taillée, envahis par les racines, émergent du sol comme les os d'un géant enterré. Des runes, usées mais encore actives, luisent faiblement d'une lumière qui n'est pas celle de l'aube.",
  "unlock_condition": {
    "type": "group",
    "mode": "all",
    "conditions": [
      {
        "type": "zone",
        "zone_id": "lac_miroir",
        "state": "unlocked"
      },
      {
        "type": "zone",
        "zone_id": "sous_bois_perdu",
        "state": "unlocked"
      }
    ]
  },
  "hint": "On raconte que les ruines n'apparaissent qu'à ceux qui ont arpenté à la fois les eaux et les bois profonds.",
  "generation_brief": {
    "level_range": [
      6,
      9
    ],
    "difficulty_tier": "coeur",
    "tags": [
      "ruines",
      "mine",
      "archeologie",
      "runes",
      "combat"
    ],
    "content_intent": "Combat plus difficile contre des constructions animées des Architectes, minage et archéologie au centre du gameplay, runes à découvrir qui posent les bases du lore.",
    "provides": [
      {
        "type": "item",
        "id_suggere": "fragment_rune_aube",
        "via": "Lâché par une construction des Architectes qui garde un mur effondré, ou remis en récompense d'une quête d'exploration des ruines : un fragment de rune encore tiède. Ne dépend d'aucun niveau de métier."
      }
    ]
  },
