{
  "id": "lac_miroir",
  "name": "Lac-Miroir",
  "type": "water",
  "position": {
    "x": 50,
    "y": 60
  },
  "visibility": "visible",
  "description": "Plus loin sur l'eau, le lac devient un miroir parfait, presque trop immobile. Quelque chose, sous la surface, semble observer en retour.",
  "unlock_condition": {
    "type": "item",
    "item_id": "amulette_pecheur",
    "state": "owned"
  },
  "hint": "Nul ne s'aventure sur les eaux profondes sans une amulette bénie par les pêcheurs.",
  "generation_brief": {
    "level_range": [
      4,
      6
    ],
    "difficulty_tier": "coeur",
    "tags": [
      "lac",
      "mystere",
      "peche_avancee",
      "tension"
    ],
    "content_intent": "Récolte avancée (pêche rare, plantes aquatiques rares) et créatures du lac légèrement altérées par l'aube ; ambiance de tension latente, quelque chose d'anormal sous la surface.",
    "provides": [
      {
        "type": "quest",
        "id_suggere": "chant_du_lac",
        "via": "Une mélodie sourde monte parfois du fond du lac ; une quête d'enquête permet de la localiser et de la comprendre en partie."
      }
    ]
  },
