{
  "id": "foret_ancienne",
  "name": "Forêt des Anciens",
  "type": "wilderness",
  "position": {
    "x": 45,
    "y": 28
  },
  "visibility": "visible",
  "description": "Des arbres aux troncs noueux, plus vieux que mémoire d'homme, forment une voûte où la lumière dorée peine à filtrer. Des pierres moussues, à peine visibles, portent des motifs qui ne ressemblent à aucune écriture connue.",
  "unlock_condition": {
    "type": "zone",
    "zone_id": "sentier_lisiere",
    "state": "unlocked"
  },
  "hint": "Les arbres centenaires se dressent au bout du sentier, silencieux.",
  "generation_brief": {
    "level_range": [
      4,
      6
    ],
    "difficulty_tier": "coeur",
    "tags": [
      "foret",
      "bucheronnage",
      "herboristerie",
      "combat"
    ],
    "content_intent": "Zone dense mêlant combat contre faune forestière, bûcheronnage et herboristerie ; indices discrets de présence architecte (pierres moussues, symboles à peine visibles).",
    "provides": [
      {
        "type": "quest",
        "id_suggere": "piste_du_cerf_blanc",
        "via": "Une piste étrange, laissée par un cerf à la robe trop pâle, peut être suivie à travers la forêt jusqu'à une quête dédiée."
      }
    ]
  },
