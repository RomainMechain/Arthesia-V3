{
  "id": "sanctuaire_aube",
  "name": "Sanctuaire de l'Aube Figée",
  "type": "ruins",
  "position": {
    "x": 80,
    "y": 48
  },
  "visibility": "visible",
  "description": "Un ensemble de colonnes effondrées entoure une chambre où la lumière dorée s'intensifie de façon presque douloureuse. L'air lui-même semble retenir son souffle, comme avant un événement qui ne s'est jamais produit.",
  "unlock_condition": {
    "type": "zone",
    "zone_id": "ruines_architectes",
    "state": "unlocked"
  },
  "hint": "Au-delà des pierres gravées, une lumière plus dorée encore filtre entre les colonnes.",
  "generation_brief": {
    "level_range": [
      8,
      10
    ],
    "difficulty_tier": "profondeurs",
    "tags": [
      "sanctuaire",
      "ruines",
      "rituel",
      "pre-boss"
    ],
    "content_intent": "Antichambre du gardien : les monstres normaux les plus durs de l'étage (gardiens et constructions des Architectes), au plus une élite, préparation rituelle, inscriptions plus explicites sur le mécanisme de l'aube sans tout révéler.",
    "provides": [
      {
        "type": "quest",
        "id_suggere": "cle_des_dormants",
        "via": "Un rituel partiellement reconstitué à partir des inscriptions du sanctuaire doit être accompli pour obtenir le droit de passage vers le gardien."
      }
    ]
  },
