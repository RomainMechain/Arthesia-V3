{
  "id": "jardins_suspendus",
  "name": "Les Jardins Suspendus",
  "type": "wilderness",
  "position": {
    "x": 32,
    "y": 42
  },
  "visibility": "visible",
  "description": "D'anciens vergers architectes poussent encore ici, leurs fruits luisant d'une couleur qui n'existe nulle part ailleurs. Des créatures faites de pétales et de lumière errent entre les rangées d'arbres flottants, indifférentes à la chute qui les entoure.",
  "unlock_condition": {
    "type": "level",
    "min": 3
  },
  "hint": "On raconte que seuls ceux qui ont déjà pris de l'altitude dans leur voyage peuvent sentir le vent porteur qui mène à ces jardins.",
  "generation_brief": {
    "level_range": [
      3,
      5
    ],
    "tags": [
      "récolte",
      "faune étrange",
      "couleurs vives",
      "combat léger"
    ],
    "content_intent": "Mélange de récolte (fruits et essences lumineuses) et de combats légers contre une faune curieuse. Une quête donne à réfléchir sur les Architectes disparus, et fournit à terme un objet-relique et une quête menant plus loin dans l'étage.",
    "provides": [
      {
        "type": "quest",
        "id_suggere": "vents_ascendants",
        "via": "Une quête narrative où le joueur aide un botaniste à retrouver une graine ancienne ; sa complétion ouvre la voie vers un lieu plus reculé."
      },
      {
        "type": "item",
        "id_suggere": "relique_du_vent",
        "via": "Récompense d'une quête secondaire ou drop rare d'une des créatures de pétales, un fragment gravé d'une rune architecte."
      }
    ]
  },
